"""Command-line interface for {{name}}."""

from typing import Annotated

import typer

app = typer.Typer(no_args_is_help=True)


@app.callback()
def main() -> None:
    """{{name}} command-line tools."""


@app.command()
def hello(name: Annotated[str, typer.Argument(help="Who to greet.")] = "world") -> None:
    """Greet someone by name."""
    cleaned = name.strip()
    if not cleaned:
        raise typer.BadParameter("name must not be blank")
    typer.echo(f"Hello, {cleaned}!")
