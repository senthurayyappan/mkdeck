[project]
name = {{name_json}}
version = "0.1.0"
description = {{description_json}}
readme = "README.md"
authors = [{ name = {{author_json}} }]
requires-python = ">={{python}}"
{{license_metadata}}
dependencies = {{dependencies}}

[project.urls]
Repository = "https://github.com/{{owner}}/{{repo}}"
Documentation = "https://{{owner}}.github.io/{{repo}}/"

{{build_system}}
[dependency-groups]
dev = [
    "pytest>=8",
    "pytest-cov>=6",
    "pre-commit>=4",
    "ruff>=0.15.17",
    "ty>=0.0.72",
{{deptry_dependency}}]
docs = [
    "mkdocs>=1.6.1,<2",
    "mkdocs-shadcn>=0.12,<0.13",
    "mkdocstrings[python]>=1,<2",
    "pymdown-extensions>=10",
]

[tool.ruff]
line-length = 120
target-version = "py{{python_digits}}"
{{ruff_src}}

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "C4", "SIM", "RUF", "N", "A", "T10", "PGH"{{docstring_rules}}]
ignore = ["E501"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["D"]
"**/*.ipynb" = ["D", "E402", "I"]

[tool.ruff.format]
quote-style = "double"
docstring-code-format = true

[tool.ty.src]
include = {{type_paths}}

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["--strict-config", "--strict-markers", "--import-mode=importlib"]
{{pytest_extra}}
[tool.coverage.run]
branch = true
source = {{coverage_source}}
omit = ["tests/*"]

[tool.coverage.report]
show_missing = true
skip_empty = true

{{deptry_config}}
