.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ty_cache/
.coverage*
build/
dist/
*.egg-info/
site/
.DS_Store

# Local tool state (Claude Code settings and worktrees).
.claude/

# The vendored front-end ships inside the wheel, and reveal.js and KaTeX both keep
# their files under dist/, which the build-artifact rule above would swallow.
!src/mkdeck/assets/*/dist/
!src/mkdeck/assets/*/dist/**
